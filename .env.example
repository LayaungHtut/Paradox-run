# Build-time settings (Vite). Copy the lines you need into .env.local, or into
# .env.static.local / .env.android.local for those builds.

# Public HTTPS origin of a leaderboard server, for static and Android builds.
# VITE_API_URL=https://paradoxrun.fly.dev

# Public web address for "beat my ghost" share links (defaults to the page origin; the Android app
# defaults to VITE_API_URL, since the Node server also serves the web game).
# VITE_PUBLIC_URL=https://paradoxrun.fly.dev

# Contact address shown on /privacy. Play Store requires a real one.
# VITE_CONTACT_EMAIL=you@example.com

# Server runtime settings (the Node build reads these when it starts, not at build time):
# DATA_DIR=/data
# PORT=3000
# ORIGIN=https://paradoxrun.fly.dev
# ADDRESS_HEADER=Fly-Client-IP
# CORS_ORIGINS=*
